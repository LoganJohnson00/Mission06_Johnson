@{
    
}
@* Using the movie model *@
@model Movie

<h2>Confirm Deletion</h2>
<h3>@Model.Title</h3>

@* This gives the user the choice to delete or return to the movie list view *@
<form method="post">
    <input type="hidden" asp-for="MovieId"/>
    <button type="submit">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="MovieList">Cancel</a> 
</form>